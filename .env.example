DATABASE_URL="postgresql://user:password@localhost:5432/prostep2market"
NEXTAUTH_SECRET="your-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# OAuth (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI - for AI learning path engine
OPENAI_API_KEY=""

# Video hosting (Mux)
MUX_TOKEN_ID=""
MUX_TOKEN_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
FROM_EMAIL="noreply@yourdomain.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ProStep"

# Analytics (Plausible — privacy-first, GDPR-compliant)
# Set your domain to enable (e.g. "prostep2market.com")
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
# Optional: custom script URL for self-hosted Plausible or proxy
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL="https://plausible.io/js/script.js"

# Error Monitoring (Sentry)
# Set your DSN from Sentry project settings to enable
NEXT_PUBLIC_SENTRY_DSN=""
# Optional: override environment label (defaults to VERCEL_ENV or "production")
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# Sentry Source Map Upload (build-time only — add to Vercel/CI env)
# Get these from: Sentry → Settings → Projects → [project] → General
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"
# SENTRY_AUTH_TOKEN="your-auth-token-from-sentry-settings"
